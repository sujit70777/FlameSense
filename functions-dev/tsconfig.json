{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "rootDir": "..",
    "outDir": "dist"
  },
  "include": ["../functions/api/**/*.ts", "../functions/lib/**/*.ts", "test/**/*.ts"]
}
